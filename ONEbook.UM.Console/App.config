<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
  </configSections>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.6.1" />
  </startup>
  <Fanex.Logging msmqPath="FormatName:DIRECT=http://10.35.35.254:808/msmq/Private$/entlib" defaultCategory="$CategoryValue" />
  <ONEbook.UM ServiceUris="http://ha.nexdev.net:8889/api" EnableCheckUM="true"
              EnableUnscheduledUM="false"
              UMFrom="03:00" UMTo="04:00" SiteId="2000000"
              UMPageUrl="~/UserLogin/Common/Offline">
  </ONEbook.UM>
</configuration>