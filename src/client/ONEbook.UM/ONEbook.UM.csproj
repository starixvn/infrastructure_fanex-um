<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net461;net5.0;net6.0;net8.0;net9.0</TargetFrameworks>
    <Version>3.1.4-beta0</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReleaseNotes>Support clear cache</PackageReleaseNotes>
    <PackageProjectUrl>https://gitlab.nexdev.net/infrastructure/fanex-um</PackageProjectUrl>
    <RepositoryUrl>https://gitlab.nexdev.net/infrastructure/fanex-um</RepositoryUrl>
    <RepositoryType>Core Libs</RepositoryType>
    <Copyright>@nexcel.vn</Copyright>
    <AssemblyVersion>3.1.4.0</AssemblyVersion>
    <FileVersion>3.1.4.0</FileVersion>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net461'">
    <PackageReference Include="Fanex.Caching" Version="2.2.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net5.0'">
    <PackageReference Include="Fanex.Caching" Version="2.2.7" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net6.0'">
    <PackageReference Include="Fanex.Caching" Version="2.2.7" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="Fanex.Caching" Version="2.2.7" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Fanex.Caching" Version="2.2.7" />
  </ItemGroup>
</Project>