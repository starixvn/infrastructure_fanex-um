<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <section name="ONEbook.UM.Site" type="ONEbook.UM.Site.Configurations.UMSiteConfiguration, ONEbook.UM.Site" />
  </configSections>

  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" />

  <ONEbook.UM
    ServiceUris="http://10.18.200.124:8889/api"
    EnableCheckUM="false"
    UMAddress="tcp://10.40.40.200:8989/LoadBalancerInterface"
    EnableUnscheduledUM="false"
    UMFrom="03:00"
    UMTo="04:00"
    SiteId="2000000">
    <AllowedIPs AllowAll="true">
      <add Value="10.19.10.54" /> <!--Exact IP-->
      <add From="10.19.10.100" To="10.19.10.200"/> <!--IP Range-->
    </AllowedIPs>
  </ONEbook.UM>

  <ONEbook.UM.Site AllowedLoginAccounts="terry.nguyen,ricky.nguyen" ServiceUri="http://localhost:51973/api" />

  
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.6" />
    <httpRuntime targetFramework="4.6" />
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
