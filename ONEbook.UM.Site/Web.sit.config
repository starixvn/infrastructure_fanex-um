<?xml version="1.0" encoding="utf-8"?>
<!--
  For more information on how to configure your ASP.NET application, please visit
  http://go.microsoft.com/fwlink/?LinkId=301880
  -->
<configuration>
  <configSections>
    <section name="Fanex.Logging" type="Fanex.Logging.Configuration.LoggingSettings, Fanex.Logging" />
    <section name="ONEbook.UM" type="ONEbook.UM.Configurations.UMClientConfiguration, ONEbook.UM" />
    <section name="ONEbook.UM.Site" type="ONEbook.UM.Site.Configurations.UMSiteConfiguration, ONEbook.UM.Site" />
  </configSections>

  <Fanex.Logging msmqPath="FormatName:DIRECT=tcp:[IP]\private$\entlib" defaultCategory="$CategoryValue" />

  <ONEbook.UM
    ServiceUris="http://172.16.4.106:8889/api"
    EnableCheckUM="true"
    EnableUnscheduledUM="false"
    UMFrom="03:00"
    UMTo="04:00"
    SiteId="2000">
    <AllowedIPs AllowAll="true">
    </AllowedIPs>
  </ONEbook.UM>

  <ONEbook.UM.Site AllowedLoginAccounts="terry.nguyen,ricky.nguyen,ricky.vn" ServiceUri="http://172.16.4.106:8889/api" />

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="UMServiceURL" value="http://172.16.4.32:8000/api/UM/|http://172.16.4.32:9000/api/UM/"/>
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.6" />
    <httpRuntime targetFramework="4.6" />
    <customErrors mode="Off"/>
  </system.web>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="1.0.0.0-5.2.3.0" newVersion="5.2.3.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

</configuration>
